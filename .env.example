# Environment Configuration Template
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# Application URL
BASE_URL=http://localhost:3000

# Test User Credentials
# Create a test account in your application and use those credentials here
TEST_USERNAME=test.user@example.com
TEST_EMAIL=test.user@example.com
TEST_PASSWORD=YourSecurePassword123!

# Optional: Additional Test Users
TEST_ADMIN_EMAIL=admin@example.com
TEST_ADMIN_PASSWORD=AdminPassword123!

# Browser Configuration (optional overrides)
# HEADED=false
# BROWSER=chromium

# CI/CD Configuration
# CI=false

# Test Execution Settings (optional)
# PARALLEL_WORKERS=4
# RETRIES=2
# TIMEOUT=30000

# API Configuration (if testing APIs)
# API_BASE_URL=http://localhost:3000/api
# API_KEY=your-api-key-here

# Database Configuration (if needed for test data setup)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=test_db
# DB_USER=test_user
# DB_PASSWORD=test_password

# Debugging
# DEBUG=false
# VERBOSE=false

# Screenshot and Video Settings
# SCREENSHOT_ON_FAILURE=true
# VIDEO_ON_FAILURE=true
# TRACE_ON_RETRY=true

# Report Settings
# REPORT_OUTPUT_DIR=playwright-report
# REPORT_AUTO_OPEN=false
