# ═══════════════════════════════════════════════════════════
# TestPilot - QA Automation Platform Configuration
# ═══════════════════════════════════════════════════════════

# Backend Configuration
PORT=3001
NODE_ENV=development
BACKEND_URL=http://localhost:3001

# Persistence and temporary local artifact staging
ARTIFACTS_PATH=/tmp/testpilot-artifacts

# CORS
CORS_ORIGIN=http://localhost:5173

# Frontend
FRONTEND_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# QA Test Configuration
QA_MAX_CONCURRENT_TESTS=1
MAX_TEST_DURATION_MS=300000
MAX_PAGES_TO_CRAWL=50

# ───────────────────────────────────────────────────────────
# Supabase (required by the backend test flow; anon key is safe for frontend use)
# ───────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGc...your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...your_service_role_key_here
SUPABASE_ARTIFACT_BUCKET=test-artifacts
SUPABASE_ARTIFACT_SIGNED_URL_TTL_SECONDS=3600

# ───────────────────────────────────────────────────────────
# Email Notifications (Optional)
# ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=TestPilot <noreply@testpilot.dev>

# ───────────────────────────────────────────────────────────
# Usage Limits
# ───────────────────────────────────────────────────────────
GUEST_QA_LIMIT=3
DAILY_QA_LIMIT=20

# WebSocket
ENABLE_WEBSOCKET=true

# ═══════════════════════════════════════════════════════════
# Production Deployment
# ═══════════════════════════════════════════════════════════
#
# For Vercel (Frontend):
# - Set VITE_API_URL to your backend URL
# - Set VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY
#
# For Render/Railway (Backend):
# - Set all environment variables above
# - Update CORS_ORIGIN to your frontend domain
# - Update FRONTEND_URL to your frontend domain
#
# ═══════════════════════════════════════════════════════════
